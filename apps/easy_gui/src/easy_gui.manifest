<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows: run Easy GUI with UTF-8 as the process code page (Windows 10 1903 and newer). The file dialog, drag and
     drop and ImGui all hand over UTF-8, and ChildProcess passes arguments on as UTF-8; with the legacy ANSI code page,
     narrow std::filesystem paths, argv and getenv would disagree with them for any non-ASCII path. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
